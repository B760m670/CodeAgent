# Copy to .env and fill in. Everything here can also be changed later in the web UI (⚙ Settings).

# Password for the web UI. If empty, a random token is generated and printed on start.
ACCESS_TOKEN=

PORT=3000

# --- LLM (any OpenAI-compatible API) ---
# Presets: openrouter | groq | gemini | cerebras | mistral | ollama | custom
LLM_PROVIDER=openrouter
LLM_API_KEY=
# Optional overrides (preset defaults are used when empty)
LLM_MODEL=
LLM_BASE_URL=
# Comma-separated models to try when the main one is rate-limited
LLM_FALLBACK_MODELS=
LLM_CONTEXT_WINDOW=64000

# --- GitHub ---
# Fine-grained token with: Contents (RW), Pull requests (RW), Issues (RW), Metadata (R), Checks (R)
GITHUB_TOKEN=
# Secret for the repository webhook (enables "@codeagent ..." in issues and PRs)
GITHUB_WEBHOOK_SECRET=
GITHUB_TRIGGER_PHRASE=@codeagent
GIT_USER_NAME=CodeAgent
GIT_USER_EMAIL=codeagent@users.noreply.github.com
